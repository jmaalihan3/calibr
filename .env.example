# Database Configuration
# For local development, leave DATABASE_URL unset to use SQLite
# For production (Render), this is set automatically
# DATABASE_URL=postgresql://user:pass@localhost/zcalib

# Authentication Security
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=your-secret-key-here-change-in-production
CSRF_SECRET=your-csrf-secret-here-change-in-production

# Session Configuration
SESSION_TIMEOUT_DAYS=7

# Rate Limiting (requests per minute per IP)
RATE_LIMIT_LOGIN=5
RATE_LIMIT_REGISTER=3

# Environment
ENVIRONMENT=development  # development or production
